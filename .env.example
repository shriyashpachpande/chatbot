# ==========================================
# Option 1: Direct Google Gemini (Default)
# ==========================================
# If running directly with Google AI Studio:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=sqlite:///chatbot.db

# ==========================================
# Option 2: Portkey AI Gateway (OpenAI-compatible)
# ==========================================
# If using Portkey, set USE_PORTKEY=true and provide your Portkey API key.
# If Gemini is already integrated inside your Portkey account, you DO NOT need to provide GEMINI_API_KEY.
USE_PORTKEY=false
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: Portkey Virtual Key or custom slug if needed
PORTKEY_VIRTUAL_KEY=
PORTKEY_PROVIDER=
