# ==========================================
# 1. Google Gemini Configuration (Required)
# ==========================================
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database URL
DATABASE_URL=sqlite:///chatbot.db

# ==========================================
# 2. Portkey AI Observability (Optional)
# ==========================================
# Set to false to run directly with Google Gemini (simplest setup)
# Set to true if you want Portkey logging and tracing
USE_PORTKEY=false

PORTKEY_API_KEY=your_portkey_api_key_here

# If you added Gemini as a Virtual Key in Portkey dashboard, put its Virtual Key name here:
PORTKEY_VIRTUAL_KEY=

# OR if you have a Portkey Config / Integration slug (e.g. 'gemini' or '@your-slug'):
PORTKEY_PROVIDER=gemini
